NODE_ENV=development
PORT=3001

# Conexion a Postgres: un solo enlace (produccion). Si la contrasena tiene caracteres especiales
# (@ : / # ?), van codificados en la URL. Usa una base NUEVA para esta app, no la de la app vieja.
DATABASE_URL=
# Alternativa para dev: variables sueltas (solo se usan si no hay DATABASE_URL).
# PGHOST=
# PGPORT=
# PGUSER=
# PGPASSWORD=
# PGDATABASE=
PGSSL=

CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

JWT_SECRET=

# SSO de Azure AD. AZURE_REDIRECT_URI debe estar registrado en el App Registration (tipo "Web").
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:3001/api/auth/azure/callback

# Login con HubSpot (OAuth2). HUBSPOT_REDIRECT_URI debe estar registrado en la app de HubSpot.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3001/api/auth/hubspot/callback
# Clave AES-256 (64 caracteres hex) con la que se cifran los tokens de HubSpot guardados en la BD:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HUBSPOT_TOKEN_KEY=
# Token de una app privada de HubSpot: solo para separar/liberar unidades y accesorios al aceptar una cotizacion
# (escribir objetos personalizados exige crm.objects.custom.write, que el OAuth no tiene). Opcional.
HUBSPOT_SERVICE_TOKEN=
# Id del objeto personalizado de unidades en HubSpot (por defecto 2-51798334).
# HUBSPOT_OBJECT_ID=

# PDFs de las cotizaciones (por defecto backend/data/quotes). En Docker, montarlo como volumen persistente.
# QUOTES_DIR=

# Google Drive: aqui viven los PDFs de las cotizaciones (<raiz>/Cotizaciones/<proyecto>/<id> - <negocio>/<fecha>/). Misma cuenta de servicio
# que RR.HH. y Solicitudes; la raiz es la carpeta "6. CENTRO DE APLICACIONES COMERCIALES".
# Dev local: GOOGLE_DRIVE_KEY_FILE (ruta a un .json). Produccion (Docker/Coolify): GOOGLE_DRIVE_CREDENTIALS_JSON (el .json completo).
GOOGLE_DRIVE_KEY_FILE=
GOOGLE_DRIVE_CREDENTIALS_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Fallback opcional de login: bcrypt hash de una master password de emergencia (sin escapar los "$").
MASTER_KEY_HASH=

# Llave para que otras apps de AED (Cartera) lean las cotizaciones aceptadas en /api/integracion/cotizaciones (cabecera X-API-Key). Minimo 32 caracteres; debe ser la misma que CENTRO_APLICACIONES_API_KEY en Cartera.
INTEGRACION_API_KEY=

# Solo para scripts/migrarDatosLegado.js (migracion unica desde la app vieja; NO va en produccion).
# Conexion de SOLO LECTURA a la base de la app vieja:
LEGACY_DATABASE_URL=
# Carpeta con los PDF de cotizaciones de la app vieja (server/data/quotes):
# LEGACY_QUOTES_DIR=
# Correos admin por defecto de la app vieja (separados por coma). Por defecto: rgalindo@aed.com.co,gvaldelamar@aed.com.co
# LEGACY_ADMIN_EMAILS=
